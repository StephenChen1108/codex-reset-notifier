# Default: public FxEmbed API (no X token/cookies). No automatic paid fallback.
SOURCE_PROVIDER=fxembed
# Only required when SOURCE_PROVIDER=x (official paid X API)
X_BEARER_TOKEN=
X_USERNAME=thsottiaux
MATCH_WORD=reset
X_EXCLUDE_REPLIES=false
BOOTSTRAP_NOTIFY=false
# Include reset discussions/requests as explicitly unconfirmed alerts.
INCLUDE_MENTIONS=false
TARGET_TIMEZONE=Asia/Shanghai
# Optional assumption for clock times without a source timezone. Blank = unknown.
SOURCE_TIMEZONE=
STATE_PATH=data/state.json
# Optional public dashboard projection. Actions writes this on the monitor-state branch.
PUBLIC_STATUS_PATH=data/status.json
POLL_INTERVAL_SECONDS=300

# Telegram (comma-separated chat IDs; configure both or leave both blank)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=
# Discord incoming webhook URLs, comma-separated
DISCORD_WEBHOOK_URLS=
# Generic JSON webhook URLs, comma-separated (HTTPS)
WEBHOOK_URLS=
# Optional HMAC-SHA256 signing key for generic webhooks
WEBHOOK_SECRET=
# Sanitized generic-webhook diagnostics: hostname, delivery ID prefix, status and timing only.
WEBHOOK_DEBUG=false

# Resend email (configure all three or leave all blank)
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_TO=
# Twilio SMS (configure all four or leave all blank)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
SMS_TO=

# Feishu app credentials: independent Secrets, never commit actual values.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_RECEIVE_ID=
FEISHU_RECEIVE_ID_TYPE=open_id
# Local-only alternative: read Soar's existing credential/recipient files, without imports/writes.
SOAR_FEISHU_READONLY=false
